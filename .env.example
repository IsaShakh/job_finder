# Скопируйте в .env. Не публикуйте .env, токены или каталог .state.
# Токен бота от @BotFather; формат: <число>:<буквы, цифры, подчёркивания, минусы>.
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца в личном чате (он же получатель уведомлений).
# Узнать автоматически: .venv/bin/python -m job_finder pair
# (или спросить свой ID у @userinfobot и вписать вручную).
TELEGRAM_OWNER_ID=

# OpenAI-совместимый HTTPS endpoint Chat Completions. Модель выбирается явно.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Автоотклик удалён (этап 1b): откликаетесь вы сами. Браузер не используется;
# доступ к вакансиям — только через API HH (вход: python -m job_finder api-login).
SEARCH_INTERVAL=21600
MAX_SEARCH_PAGES=100
