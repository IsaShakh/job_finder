# Скопируйте в .env. Не публикуйте .env, токены или каталог .state.
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца в личном чате; это также ID получателя уведомлений.
TELEGRAM_OWNER_ID=

# OpenAI-совместимый HTTPS endpoint. Модель выбирается явно.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

HH_RESUME_ID=b424f687ff113123eb0039ed1f7a496e413267
# Реальная отправка выключена. /resume только снимает паузу, не меняет режим.
HH_LIVE=false
HH_HEADLESS=false
SEARCH_INTERVAL=21600
SEND_INTERVAL=90
MAX_SEARCH_PAGES=100
