# Скопируйте в .env. Не публикуйте .env, токены или каталог .state.
# Токен бота от @BotFather; формат: <число>:<буквы, цифры, подчёркивания, минусы>.
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца в личном чате (он же получатель уведомлений).
# Узнать автоматически: .venv/bin/python -m job_finder pair
# (или спросить свой ID у @userinfobot и вписать вручную).
TELEGRAM_OWNER_ID=

# OpenAI-совместимый HTTPS endpoint Chat Completions. Модель выбирается явно.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Автоотклик удалён (этап 1b): откликаетесь вы сами. Браузер не используется;
# доступ к вакансиям — только через API HH (вход: python -m job_finder api-login).
# Источники поиска (этап 2): имена адаптеров через запятую
# (hh, remoteok, habr, wwr, telegram, fake для отладки).
SOURCES=hh
# Telegram-каналы (этап 6.4): имя:регион через запятую; регион RU или intl.
# Нужны TG_API_ID/TG_API_HASH (my.telegram.org) и вход scripts/tg_probe_login.command.
# TG_CHANNELS=nopremote:RU,pythonrabota:RU,job_python:RU,remotegeekjob:intl
# TG_API_ID=
# TG_API_HASH=
# Профили отбора (этап 2a): ru — удалёнка/Москва, порог 150 000 ₽/мес;
# intl — удалёнка/Дубай, без зарплатного порога. Вакансия проходит, если
# проходит хотя бы один профиль.
PROFILES=ru,intl
MAX_SEARCH_PAGES=100
